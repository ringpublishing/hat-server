{
    "name": "hat-server",
    "version": "3.0.0",
    "description": "Head App Template - server",
    "license": "MIT",
    "repository": {},
    "main": "src/index.ts",
    "module": "src/index.ts",
    "source": "src/index.ts",
    "types": "src/index.ts",
    "engines": {
        "node": "^22"
    },
    "private": false,
    "dependencies": {
        "@ringpublishing/graphql-api-client": "^4.2.0",
        "@ringpublishing/graphql-api-client-got": "^2.3.0",
        "@types/http-server": "^0.12.1",
        "@types/node": "*"
    },
    "devDependencies": {
        "@ringieraxelspringer/tsconfig": "^4.0.0",
        "typescript": "~4.7.4",
        "node-mocks-http": "^1.12.1",
        "ts-jest": "^29.0.3",
        "jest": "^29.3.1",
        "@types/jest": "^29.2.4",
        "@jest/globals": "^29.3.1"
    },
    "scripts": {
        "test": "jest --no-cache --detectOpenHandles --runInBand --forceExit",
        "test-watch": "jest --watchAll --no-cache --detectOpenHandles --runInBand --forceExit"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "transform": {
            "^.+\\.ts?$": "ts-jest"
        },
        "transformIgnorePatterns": [
            ",<rootDir>/node_modules/"
        ],
        "clearMocks": true
    }
}
